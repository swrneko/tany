# Copy to .env and edit. Every value below is the default.

# Host port. 8927 rather than 8000, which is already taken on most home servers.
PORT=8927

# Single volume holding the database, media and the instance secret.
# Back up the whole thing: tar czf backup.tgz /data
DATA_DIR=/data

# builtin  - accounts live here; the first start opens a setup wizard
# proxy    - identity comes from a reverse proxy (Authelia, authentik, ...)
# disabled - no authentication at all; only sane on a trusted localhost
AUTH_MODE=builtin
PROXY_USER_HEADER=X-Remote-User

# How long a signed session cookie stays valid.
SESSION_MAX_AGE_DAYS=30

# Set to true once the instance is served over HTTPS, so the session cookie
# never travels in the clear. Leave false while testing over plain http.
SESSION_COOKIE_SECURE=false

# Largest upload accepted, in bytes. Default is 5 GiB.
MAX_UPLOAD_SIZE=5368709120

# --- Speech to text -----------------------------------------------------
# Any OpenAI-compatible /v1/audio/transcriptions endpoint: speaches, whisper.cpp
# server, faster-whisper-server, LocalAI, or the OpenAI API itself.
#
# These three seed the database on an empty installation and are ignored
# afterwards -- from then on the provider is edited in the app, not here.
#
# Reaching a service on the host from inside the container needs
# host.docker.internal, not localhost. That mistake accounts for most
# self-hosting failures, and the app's connection test exists to catch it.
STT_BASE_URL=http://host.docker.internal:8000/v1
STT_MODEL=Systran/faster-whisper-small
# STT_API_KEY=sk-...
